#!/usr/bin/env bash
# Run the findit helper in FindIt's own environment (read-only).
#   findit <command> [options]     e.g. findit report --month 2026-09
# FindIt's location: $FINDIT_ROOT, else the path install.sh saved in ../findit_root,
# else /Users/varun/Downloads/Varun/Find_v2.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
root="${FINDIT_ROOT:-}"
if [ -z "$root" ] && [ -s "$here/../findit_root" ]; then
  root="$(head -n 1 "$here/../findit_root")"
fi
root="${root:-/Users/varun/Downloads/Varun/Find_v2}"
export FINDIT_ROOT="$root" PYTHONDONTWRITEBYTECODE=1
if [ -x "$root/.venv/bin/python" ]; then
  exec "$root/.venv/bin/python" "$here/findit_query.py" "$@"
fi
# Sandboxes may deny access to uv's default cache under the user's home.
# Respect explicit cache settings; otherwise uv manages a temporary cache.
if [ -z "${UV_CACHE_DIR+x}" ] && [ -z "${UV_NO_CACHE+x}" ]; then
  exec uv --no-cache run --no-sync --project "$root" python "$here/findit_query.py" "$@"
fi
exec uv run --no-sync --project "$root" python "$here/findit_query.py" "$@"
